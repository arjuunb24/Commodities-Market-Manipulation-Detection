# =============================================================================
# Veridex — .gitignore
# =============================================================================

# Secrets — NEVER commit
.env

# Virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter notebooks — checkpoints only (commit the .ipynb files)
.ipynb_checkpoints/

# =============================================================================
# Data — raw fetched data is never committed; only config outputs are
# =============================================================================
# Raw yfinance pulls and CFTC CSVs (regenerated by fetch scripts)
data/raw/

# Simulation run outputs (can be large; regenerated deterministically from seed)
# EXCEPTION: keep the designated demo run_id for viva offline demo
# To keep a specific run: git add -f data/runs/<demo_run_id>/
data/runs/

# =============================================================================
# MLflow experiment tracking (local runs)
# =============================================================================
mlruns/
mlartifacts/

# =============================================================================
# OS / IDE
# =============================================================================
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace
