# =============================================================================
# Veridex — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env to version control.
# =============================================================================

# --- LLM / Agentic Layer (Module 4) ---
# Gemini API key — used for 4B Adversarial Strategist + 4C Analyst Assistant
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Cerebras API key — used for 4A Narrative Generator (high-volume fast inference)
# Obtain from: https://cloud.cerebras.ai
CEREBRAS_API_KEY=your-cerebras-api-key-here

# --- Experiment Tracking ---
# MLflow tracking URI — defaults to local ./mlruns directory
MLFLOW_TRACKING_URI=./mlruns

# --- Logging ---
# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Demo Mode ---
# Set to true on viva day to force LLMClient to use cached responses.
# Ensures offline resilience — see Implementation Plan Section 8.5.
DEMO_MODE=false
